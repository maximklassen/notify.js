{
    "name": "@maximklassen/notify",
    "version": "1.0.0",
    "description": "Lightweight TypeScript notification library",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/index.global.js",
    "files": [
        "dist",
        "src/notify.css"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "notification",
        "toast",
        "popup",
        "typescript",
        "ui"
    ],
    "author": "Maxim Klassen",
    "license": "MIT",
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/maximklassen/notify.js.git"
    },
    "bugs": {
        "url": "https://github.com/maximklassen/notify.js/issues"
    },
    "homepage": "https://github.com/maximklassen/notify.js#readme"
}
